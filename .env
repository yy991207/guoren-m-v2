# 应用运行模式：development | test | production
VITE_APP_MODE=development

# 本地开发与测试共用测试域名；生产构建由 .env.production 覆盖。
VITE_API_BASE_URL=https://ai.tongda365.com.cn/jeecg-boot
VITE_AI_API_BASE_URL=https://ai.tongda365.com.cn
VITE_IM_MESSAGING_BASE_URL=https://ai.tongda365.com.cn/api/v1/messaging

# AI 附件上传与桌面端使用同一个测试签名接口和存储桶。
VITE_OSS_SIGN_URL=https://api.tongda365.com.cn/jeecg-boot/open/aliyun/oss/v1/temp/url
VITE_OSS_BUCKET_NAME=guoren-files-test

# OSS bucket 配置（IM 图片/文件/视频上传）
VITE_OSS_BUCKET_OTHER=guoren-files-hb-test
VITE_OSS_BUCKET_VIDEO=guoren-vod-hb-test
